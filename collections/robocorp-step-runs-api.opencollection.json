{
  "opencollection": "1.0.0",
  "info": {
    "name": "Robocorp Control Room Assets Step Runs API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Step Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Step Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.robocorp.com/api/v1/workspaces/:workspace_id/processes/:process_id/runs/:run_id/step-runs",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "The workspace identifier"
              },
              {
                "name": "process_id",
                "value": "",
                "type": "path",
                "description": "The process identifier"
              },
              {
                "name": "run_id",
                "value": "",
                "type": "path",
                "description": "The process run identifier"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List all step runs within a process run."
        },
        {
          "info": {
            "name": "Get Step Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.robocorp.com/api/v1/workspaces/:workspace_id/processes/:process_id/runs/:run_id/step-runs/:step_run_id",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "The workspace identifier"
              },
              {
                "name": "process_id",
                "value": "",
                "type": "path",
                "description": "The process identifier"
              },
              {
                "name": "run_id",
                "value": "",
                "type": "path",
                "description": "The process run identifier"
              },
              {
                "name": "step_run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve details for a specific step run."
        }
      ]
    }
  ],
  "bundled": true
}